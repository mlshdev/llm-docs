{
  "name": "llm-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run src/cli.ts build",
    "check": "bun run typecheck && bun test && bun run format:check && bun run src/cli.ts verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "update": "bun run src/cli.ts update",
    "verify": "bun run src/cli.ts verify"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tar-stream": "3.2.1",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/estree": "1.0.9",
    "@types/mdast": "4.0.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
